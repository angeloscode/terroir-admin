generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  password  String?
  role      UserRole @default(USER)
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @map(name: "updated_at")

  @@map(name: "users")
}

// Просмотры страниц публичного сайта (маячок /admin/api/track).
// Персональных данных нет: visitorId — хеш от IP, User-Agent и даты, меняется каждые сутки.
model PageView {
  id        BigInt   @id @default(autoincrement())
  path      String
  visitorId String   @map(name: "visitor_id")
  createdAt DateTime @default(now()) @map(name: "created_at")

  @@index([createdAt])
  @@map(name: "page_views")
}
