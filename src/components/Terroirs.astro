---
import { Image } from 'astro:assets';
import mezybImage from '../assets/terroir-mezyb-placeholder.png';
import rockyImage from '../assets/terroir-rocky-placeholder.png';

const terroirs = [
  {
    index: '01',
    name: 'Мезыбь',
    image: mezybImage,
    alt: 'Виноградник на известняковом склоне — временная иллюстрация терруара Мезыбь',
    description: 'Первый участок атласа. Его характер будет раскрыт через профиль почвы, рельеф, наблюдения по сезону и связанные вина.',
  },
  {
    index: '02',
    name: 'Скалистый берег',
    image: rockyImage,
    alt: 'Виноградные лозы на скалистом побережье — временная иллюстрация терруара Скалистый берег',
    description: 'Второй участок коллекции. Отличия покажем сопоставимыми данными, а не общими эпитетами.',
  },
];
---

<section class="terroirs" id="terroirs" aria-labelledby="terroirs-title">
  <div class="terroirs__header shell" data-reveal>
    <div>
      <p class="eyebrow">Терруары коллекции</p>
      <h2 class="section-title" id="terroirs-title">Два участка.<br /><em>Два прочтения места.</em></h2>
    </div>
    <p>
      Мы описываем терруары через сопоставимые данные: положение участка, почву, рельеф, климатические
      наблюдения и связанные с местом вина.
    </p>
  </div>

  <div class="terroirs__cards shell">
    {terroirs.map((terroir) => (
      <article class="terroir-card" data-reveal>
        <div class="terroir-card__media">
          <Image
            src={terroir.image}
            widths={[520, 760, 1040]}
            sizes="(max-width: 820px) 100vw, 50vw"
            format="webp"
            quality={84}
            alt={terroir.alt}
            loading="lazy"
          />
          <span class="placeholder-tag">Временное изображение</span>
          <span class="terroir-card__index">{terroir.index}</span>
        </div>
        <div class="terroir-card__body">
          <h3>{terroir.name}</h3>
          <p>{terroir.description}</p>
          <dl>
            <div><dt>Почва</dt><dd>Уточняется</dd></div>
            <div><dt>Высота</dt><dd>Уточняется</dd></div>
            <div><dt>Экспозиция</dt><dd>Уточняется</dd></div>
            <div><dt>Наблюдения</dt><dd>Готовятся</dd></div>
          </dl>
          <a class="text-link" href="#map">Открыть терруар</a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .terroirs {
    position: relative;
    overflow: hidden;
    padding-block: var(--section-space);
    background: var(--limestone);
    color: var(--ink);
  }

  .terroirs::before {
    position: absolute;
    inset: 0;
    content: '';
    opacity: 0.35;
    background: repeating-linear-gradient(90deg, transparent 0 calc(25% - 1px), rgba(16, 21, 16, 0.08) 25%);
    pointer-events: none;
  }

  .terroirs__header {
    position: relative;
    display: grid;
    align-items: end;
    grid-template-columns: 1.4fr minmax(18rem, 0.45fr);
    gap: 4rem;
  }

  .terroirs__header em {
    color: var(--grape);
    font-weight: 400;
  }

  .terroirs__header > p {
    margin: 0 0 0.6rem;
    color: rgba(16, 21, 16, 0.67);
  }

  .terroirs__cards {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.25rem, 3vw, 3.2rem);
    margin-top: clamp(4rem, 8vw, 8rem);
  }

  .terroir-card:nth-child(2) {
    margin-top: clamp(4rem, 8vw, 9rem);
  }

  .terroir-card__media {
    position: relative;
    overflow: hidden;
    background: var(--forest);
  }

  .terroir-card__media::after {
    position: absolute;
    inset: 0;
    content: '';
    background: linear-gradient(180deg, transparent 60%, rgba(11, 15, 11, 0.55));
  }

  .terroir-card__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.03);
    transition: transform 1.2s var(--ease-out), filter 700ms ease;
  }

  .terroir-card:hover .terroir-card__media :global(img) {
    transform: scale(1.035);
    filter: saturate(1) contrast(1.02);
  }

  .terroir-card .placeholder-tag {
    position: absolute;
    z-index: 2;
    top: 1rem;
    right: 1rem;
    background: rgba(16, 21, 16, 0.62);
    color: var(--chalk);
  }

  .terroir-card__index {
    position: absolute;
    z-index: 2;
    right: 1rem;
    bottom: 0.5rem;
    color: rgba(247, 243, 234, 0.82);
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 9vw, 9rem);
    line-height: 1;
  }

  .terroir-card__body {
    padding-top: 1.7rem;
  }

  .terroir-card__body h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4vw, 4.8rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .terroir-card__body > p {
    max-width: 34rem;
    margin: 1.25rem 0 0;
    color: rgba(16, 21, 16, 0.66);
  }

  .terroir-card dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 2rem 0;
    border-top: 1px solid var(--line-dark);
  }

  .terroir-card dl > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line-dark);
    font-size: 0.62rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .terroir-card dl > div:nth-child(odd) {
    padding-right: 1rem;
  }

  .terroir-card dl > div:nth-child(even) {
    padding-left: 1rem;
    border-left: 1px solid var(--line-dark);
  }

  .terroir-card dt {
    color: rgba(16, 21, 16, 0.55);
  }

  .terroir-card dd {
    margin: 0;
    color: var(--grape);
  }

  @media (max-width: 900px) {
    .terroirs__header {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .terroirs__header > p {
      max-width: 36rem;
    }
  }

  @media (max-width: 720px) {
    .terroirs__cards {
      grid-template-columns: 1fr;
    }

    .terroir-card:nth-child(2) {
      margin-top: 2.5rem;
    }

    .terroir-card dl {
      grid-template-columns: 1fr;
    }

    .terroir-card dl > div:nth-child(odd),
    .terroir-card dl > div:nth-child(even) {
      padding-inline: 0;
      border-left: 0;
    }
  }
</style>
