---
import { Image } from 'astro:assets';
import vineyard from '../assets/video-vineyard-wide.png';
import sunset from '../assets/video-sunset.png';
import vines from '../assets/video-vines.png';
import soil from '../assets/soil-grape-placeholder.png';

const materials = [
  { type: 'Фильм', title: 'Земля формирует', description: 'Короткий фильм о том, как читают участок прежде, чем говорить о вкусе.', image: vineyard, alt: 'Виноградник у подножия гор', length: '04:20' },
  { type: 'Фильм', title: 'Лоза запоминает', description: 'Сезон в винограднике глазами людей, которые каждый день работают с лозой.', image: sunset, alt: 'Закат над рельефом виноградника', length: '06:40' },
  { type: 'Исследование', title: 'Море — один из факторов', description: 'Связи между побережьем, рельефом, движением воздуха и виноградником.', image: vines, alt: 'Ряды виноградных лоз', length: '8 минут' },
  { type: 'Интервью', title: 'Как читать участок', description: 'Разговор о данных, наблюдениях и границе между фактом и интерпретацией.', image: soil, alt: 'Камень почвы и виноградная ягода', length: '12 минут' },
];
---

<section class="journal" id="journal" aria-labelledby="journal-title">
  <div class="journal__header shell">
    <h2 class="section-title" id="journal-title" data-reveal>Смотреть, читать<br /><em>исследовать</em></h2>
    <p data-reveal>Фильмы, исследования и разговоры о людях, участках и решениях, из которых складывается коллекция.</p>
  </div>

  <div class="journal__content shell">
    <article class="journal-feature" data-reveal>
      <a href="#journal" aria-label={'Фильм: ' + materials[0].title}>
        <div class="journal-feature__media">
          <Image src={materials[0].image} widths={[720, 1080, 1440]} sizes="(max-width: 820px) 100vw, 60vw" format="webp" quality={84} alt={materials[0].alt} loading="lazy" />
          <span class="journal-card__play" aria-hidden="true">▶</span>
        </div>
        <div class="journal-feature__copy">
          <div class="journal-card__meta"><span>{materials[0].type}</span><span>{materials[0].length}</span></div>
          <h3>{materials[0].title}</h3>
          <p>{materials[0].description}</p>
        </div>
      </a>
    </article>

    <div class="journal__grid">
      {materials.slice(1).map((material, index) => (
        <article class="journal-card" data-reveal>
          <a href="#journal" aria-label={material.type + ': ' + material.title}>
            <div class="journal-card__media">
              <Image src={material.image} widths={[480, 720, 960]} sizes="(max-width: 700px) 100vw, 33vw" format="webp" quality={82} alt={material.alt} loading="lazy" />
              {index === 0 && <span class="journal-card__play" aria-hidden="true">▶</span>}
            </div>
            <div class="journal-card__meta"><span>{material.type}</span><span>{material.length}</span></div>
            <h3>{material.title}</h3>
            <p>{material.description}</p>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .journal { padding-block: var(--section-space); background: var(--limestone); color: var(--ink); }
  .journal__header { display: grid; align-items: end; grid-template-columns: 1.25fr minmax(19rem, 0.45fr); gap: clamp(3rem, 7vw, 8rem); }
  .journal__header h2 { margin: 0; }
  .journal__header em { color: var(--grape); font-weight: 400; }
  .journal__header > p { margin: 0 0 0.5rem; color: rgba(16, 21, 16, 0.64); font-size: clamp(0.98rem, 1.15vw, 1.12rem); }
  .journal__content { margin-top: clamp(4rem, 7vw, 7rem); }
  .journal-feature { background: var(--ink); color: var(--chalk); }
  .journal-feature > a { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(23rem, 0.65fr); min-height: 32rem; }
  .journal-feature__media, .journal-card__media { position: relative; overflow: hidden; background: var(--forest); }
  .journal-feature__media :global(img), .journal-card__media :global(img) { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.78); transition: transform 1.15s var(--ease-out), filter 650ms ease; }
  .journal-feature a:hover :global(img), .journal-card a:hover :global(img) { transform: scale(1.04); filter: saturate(1); }
  .journal-feature__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(2rem, 4vw, 4rem); }
  .journal-card__meta { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 0.8rem; border-bottom: 1px solid rgba(16, 21, 16, 0.19); color: rgba(16, 21, 16, 0.54); font-size: 0.59rem; letter-spacing: 0.11em; text-transform: uppercase; }
  .journal-feature .journal-card__meta { border-color: rgba(247, 243, 234, 0.2); color: rgba(247, 243, 234, 0.55); }
  .journal-feature h3 { margin: 3rem 0 0; font-family: var(--font-display); font-size: clamp(2.7rem, 4vw, 4.2rem); font-weight: 400; letter-spacing: -0.05em; line-height: 0.95; }
  .journal-feature p { margin: 1.25rem 0 0; color: rgba(247, 243, 234, 0.64); }
  .journal-card__play { position: absolute; z-index: 2; right: 1rem; bottom: 1rem; display: grid; width: 3.6rem; height: 3.6rem; border: 1px solid rgba(247, 243, 234, 0.72); border-radius: 50%; background: rgba(16, 21, 16, 0.3); color: #fff; font-size: 0.65rem; place-items: center; transition: transform 450ms var(--ease-out), background 300ms ease; }
  .journal a:hover .journal-card__play { background: var(--clay); transform: scale(1.08); }
  .journal__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 2rem); margin-top: clamp(2.5rem, 4vw, 4rem); }
  .journal-card { min-width: 0; }
  .journal-card__media { aspect-ratio: 4 / 3; }
  .journal-card__meta { margin-top: 1rem; }
  .journal-card h3 { margin: 1.25rem 0 0; font-family: var(--font-display); font-size: clamp(1.8rem, 2.6vw, 2.8rem); font-weight: 400; letter-spacing: -0.04em; line-height: 1; }
  .journal-card > a > p { min-height: 4.8em; margin: 0.85rem 0 0; color: rgba(16, 21, 16, 0.62); font-size: 0.88rem; }
  @media (max-width: 900px) { .journal__header { grid-template-columns: 1fr; gap: 2rem; } .journal-feature > a { grid-template-columns: 1fr; } .journal-feature__media { min-height: 27rem; } .journal-feature__copy { min-height: 24rem; } .journal__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .journal-feature__media { min-height: 20rem; } .journal-feature__copy { min-height: 22rem; } .journal__grid { grid-template-columns: 1fr; gap: 3rem; } .journal-card > a > p { min-height: 0; } }
</style>
