---
import { Image } from 'astro:assets';
import vineyard from '../assets/video-vineyard-wide.png';
import sunset from '../assets/video-sunset.png';
import vines from '../assets/video-vines.png';
import soil from '../assets/soil-grape-placeholder.png';

const materials = [
  {
    type: 'Фильм',
    title: 'Земля формирует',
    description: 'Короткий фильм о том, как участок читают прежде, чем говорить о вкусе.',
    image: vineyard,
    alt: 'Виноградник у подножия гор, кадр из видео проекта',
    length: 'Скоро',
  },
  {
    type: 'Фильм',
    title: 'Лоза запоминает',
    description: 'О сезоне в винограднике — через наблюдения людей, работающих с лозой.',
    image: sunset,
    alt: 'Закат над горным рельефом, кадр из видео проекта',
    length: 'Скоро',
  },
  {
    type: 'Исследование',
    title: 'Море — один из факторов',
    description: 'О связях между побережьем, рельефом, движением воздуха и виноградником.',
    image: vines,
    alt: 'Ряды виноградных лоз, кадр из видео проекта',
    length: 'Материал готовится',
  },
  {
    type: 'Интервью',
    title: 'Как читать участок',
    description: 'Разговор о данных, наблюдениях и границе между фактом и интерпретацией.',
    image: soil,
    alt: 'Известняковая почва и виноградная ягода — временная иллюстрация',
    length: 'Материал готовится',
  },
];
---

<section class="journal" id="journal" aria-labelledby="journal-title">
  <div class="journal__header shell" data-reveal>
    <div>
      <p class="eyebrow">Фильмы и материалы</p>
      <h2 class="section-title" id="journal-title">Смотреть. Читать.<br /><em>Исследовать.</em></h2>
    </div>
    <p>Материалы о людях, участках и решениях, из которых складывается коллекция.</p>
  </div>

  <div class="journal__grid shell">
    {materials.map((material, index) => (
      <article class:list={['journal-card', { 'journal-card--lead': index === 0 }]} data-reveal>
        <a href="#journal" aria-label={`${material.type}: ${material.title} — скоро`}>
          <div class="journal-card__media">
            <Image
              src={material.image}
              widths={[480, 720, 1040, 1440]}
              sizes={index === 0 ? '(max-width: 900px) 100vw, 64vw' : '(max-width: 900px) 100vw, 33vw'}
              format="webp"
              quality={82}
              alt={material.alt}
              loading="lazy"
            />
            {index < 2 && <span class="journal-card__play" aria-hidden="true">▶</span>}
          </div>
          <div class="journal-card__meta">
            <span>{material.type}</span>
            <span>{material.length}</span>
          </div>
          <h3>{material.title}</h3>
          <p>{material.description}</p>
          <span class="journal-card__link">Открыть <i aria-hidden="true">↗</i></span>
        </a>
      </article>
    ))}
  </div>
</section>

<style>
  .journal {
    padding-block: var(--section-space);
    background: var(--limestone);
    color: var(--ink);
  }

  .journal__header {
    display: grid;
    align-items: end;
    grid-template-columns: 1.4fr minmax(18rem, 0.4fr);
    gap: 4rem;
  }

  .journal__header em {
    color: var(--grape);
    font-weight: 400;
  }

  .journal__header > p {
    margin: 0;
    color: rgba(16, 21, 16, 0.64);
  }

  .journal__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3rem, 7vw, 7rem) clamp(1.3rem, 3vw, 3rem);
    margin-top: clamp(4rem, 8vw, 8rem);
  }

  .journal-card--lead {
    grid-column: 1 / -1;
  }

  .journal-card__media {
    position: relative;
    overflow: hidden;
    background: var(--forest);
  }

  .journal-card__media::after {
    position: absolute;
    inset: 0;
    content: '';
    background: linear-gradient(180deg, transparent 55%, rgba(16, 21, 16, 0.52));
  }

  .journal-card__media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    filter: saturate(0.78);
    transition: transform 1s var(--ease-out), filter 500ms ease;
  }

  .journal-card--lead .journal-card__media :global(img) {
    aspect-ratio: 16 / 7;
  }

  .journal-card a:hover .journal-card__media :global(img) {
    transform: scale(1.025);
    filter: saturate(1);
  }

  .journal-card__play {
    position: absolute;
    z-index: 2;
    right: 1.2rem;
    bottom: 1.2rem;
    display: grid;
    width: 4rem;
    height: 4rem;
    border: 1px solid rgba(247, 243, 234, 0.72);
    border-radius: 50%;
    background: rgba(16, 21, 16, 0.25);
    color: var(--chalk);
    font-size: 0.7rem;
    place-items: center;
    transition: transform 350ms var(--ease-out), background 250ms ease;
  }

  .journal-card a:hover .journal-card__play {
    transform: scale(1.08);
    background: var(--clay);
  }

  .journal-card__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--line-dark);
    color: rgba(16, 21, 16, 0.55);
    font-size: 0.58rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .journal-card__meta span {
    color: rgba(16, 21, 16, 0.68);
  }

  .journal-card h3 {
    margin: 1.4rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.7vw, 4.3rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .journal-card:not(.journal-card--lead) h3 {
    font-size: clamp(1.8rem, 2.8vw, 3rem);
  }

  .journal-card > a > p {
    max-width: 36rem;
    margin: 1rem 0 0;
    color: rgba(16, 21, 16, 0.64);
  }

  .journal-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.2rem;
    font-size: 0.67rem;
    font-weight: 580;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .journal-card__link i {
    color: var(--clay);
    font-style: normal;
  }

  @media (max-width: 820px) {
    .journal__header,
    .journal__grid {
      grid-template-columns: 1fr;
    }

    .journal__header {
      gap: 2rem;
    }

    .journal-card--lead {
      grid-column: auto;
    }

    .journal-card--lead .journal-card__media :global(img) {
      aspect-ratio: 16 / 10;
    }
  }
</style>
