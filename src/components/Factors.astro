---
import { Image } from 'astro:assets';
import soilImage from '../assets/soil-grape-placeholder.png';
import grapesImage from '../assets/wine-grapes-hand.png';
import vinesImage from '../assets/video-vines.png';
import sunsetImage from '../assets/video-sunset.png';
import rockyImage from '../assets/terroir-rocky-placeholder.png';
import mezybImage from '../assets/terroir-mezyb-placeholder.png';
import pourImage from '../assets/wine-pour-glass.png';

const factors = [
  { title: 'Температурная инерция', image: sunsetImage, alt: 'Виноградник в тёплом вечернем свете', mechanism: 'Вода нагревается и остывает медленнее суши, сглаживая часть температурных колебаний рядом с побережьем.', expression: 'Более ровный ход созревания помогает удерживать баланс зрелости и свежести.' },
  { title: 'Морские воздушные массы', image: mezybImage, alt: 'Виноградник между побережьем и горным рельефом', mechanism: 'Перенос воздуха со стороны моря меняет температурный и влажностный фон конкретного участка.', expression: 'Созревание может идти спокойнее, сохраняя точность ароматического профиля.' },
  { title: 'Бризовая циркуляция', image: vinesImage, alt: 'Ряды лоз, открытые движению воздуха', mechanism: 'Разница в нагреве воды и суши создаёт суточное движение воздуха между морем и берегом.', expression: 'Один из факторов, поддерживающих ясность ароматики и живой баланс вина.' },
  { title: 'Влажность', image: grapesImage, alt: 'Гроздь винограда крупным планом', mechanism: 'Влажность влияет на испарение влаги лозой и состояние виноградника в течение сезона.', expression: 'Её влияние проявляется через весь ход созревания ягоды, а не одним вкусовым маркером.' },
  { title: 'Ветер и вентиляция', image: rockyImage, alt: 'Скалистый склон виноградника у побережья', mechanism: 'Движение воздуха помогает растительному покрову просыхать и меняет водный режим лозы.', expression: 'При сбалансированном воздействии профиль вина может ощущаться более собранным.' },
  { title: 'Продолжительность сезона', image: pourImage, alt: 'Красное вино льётся в бокал', mechanism: 'Широкое окно подходящих температур даёт виноделу больше свободы при выборе срока сбора.', expression: 'Так точнее соотносятся зрелость, свежесть и структура будущего вина.' },
  { title: 'Рельеф и высота', image: soilImage, alt: 'Камень почвы рядом со спелой виноградной ягодой', mechanism: 'Высота, форма склона и экспозиция меняют получение света и движение воздуха.', expression: 'Поэтому соседние участки способны давать разные прочтения одного сезона.' },
];
---

<section class="factors" id="science" aria-labelledby="factors-title" data-factor-story>
  <div class="factors__header shell">
    <h2 class="section-title" id="factors-title" data-reveal>Как место формирует<br /><em>характер вина</em></h2>
    <div class="factors__introduction" data-reveal>
      <p>Не формула и не легенда, а система связей. Каждый фактор проходит путь от природного условия — к лозе, созреванию и возможному выражению в вине.</p>
      <a class="text-link" href="#journal">Подробнее о методологии</a>
    </div>
  </div>

  <div class="factors__slider shell" data-factor-slider>
    <div class="factors__meta">
      <span>Факторы терруара</span>
      <div class="factors__controls">
        <button type="button" data-factor-prev aria-label="Предыдущий фактор">
          <span aria-hidden="true">▶</span>
        </button>
        <button type="button" data-factor-next aria-label="Следующий фактор">
          <span aria-hidden="true">▶</span>
        </button>
      </div>
    </div>
    <div class="factors__viewport" data-factor-viewport tabindex="0">
      <div class="factors__track" role="region" aria-label="Факторы формирования терруара" data-factor-track>
        {factors.map((factor, index) => (
          <article class="factor-card" data-factor-card data-reveal>
            <div class="factor-card__media">
              <Image src={factor.image} widths={[480, 720, 960]} sizes="(max-width: 700px) 82vw, 30rem" format="webp" quality={82} alt={factor.alt} loading="lazy" />
              <span>{String(index + 1).padStart(2, '0')} / 07</span>
            </div>
            <div class="factor-card__body">
              <h3>{factor.title}</h3>
              <div class="factor-card__copy">
                <div><span>Как работает</span><p>{factor.mechanism}</p></div>
                <div><span>Возможное выражение</span><p>{factor.expression}</p></div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const factorStory = document.querySelector<HTMLElement>('[data-factor-story]');
  const factorViewport = factorStory?.querySelector<HTMLElement>('[data-factor-viewport]');
  const factorTrack = factorStory?.querySelector<HTMLElement>('[data-factor-track]');
  const factorCards = [...(factorStory?.querySelectorAll<HTMLElement>('[data-factor-card]') || [])];
  const factorPrev = factorStory?.querySelector<HTMLButtonElement>('[data-factor-prev]');
  const factorNext = factorStory?.querySelector<HTMLButtonElement>('[data-factor-next]');
  const reduceFactorMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let factorFrame = 0;

  const factorStep = () => {
    if (!factorTrack || !factorCards[0]) return 0;
    const gap = Number.parseFloat(getComputedStyle(factorTrack).columnGap) || 0;
    return factorCards[0].offsetWidth + gap;
  };

  const updateFactors = () => {
    factorFrame = 0;
    if (!factorViewport || !factorCards.length) return;
    const atStart = factorViewport.scrollLeft <= 2;
    const atEnd = factorViewport.scrollLeft >= factorViewport.scrollWidth - factorViewport.clientWidth - 2;
    if (factorPrev) factorPrev.disabled = atStart;
    if (factorNext) factorNext.disabled = atEnd;
  };

  const requestFactorUpdate = () => {
    if (factorFrame) return;
    factorFrame = requestAnimationFrame(updateFactors);
  };

  const moveFactors = (direction: -1 | 1) => {
    if (!factorViewport) return;
    factorViewport.scrollBy({ left: factorStep() * direction, behavior: reduceFactorMotion.matches ? 'auto' : 'smooth' });
  };

  factorPrev?.addEventListener('click', () => moveFactors(-1));
  factorNext?.addEventListener('click', () => moveFactors(1));
  factorViewport?.addEventListener('scroll', requestFactorUpdate, { passive: true });
  factorViewport?.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
    event.preventDefault();
    moveFactors(event.key === 'ArrowLeft' ? -1 : 1);
  });
  window.addEventListener('resize', requestFactorUpdate, { passive: true });
  requestAnimationFrame(updateFactors);
</script>

<style>
  .factors { position: relative; overflow: clip; padding-block: var(--section-space); background: #ebe5da; color: var(--ink); }
  .factors__header { display: grid; align-items: end; grid-template-columns: minmax(0, 1.25fr) minmax(20rem, 0.48fr); gap: clamp(3rem, 7vw, 8rem); }
  .factors h2 { margin: 0; }
  .factors h2 em { color: var(--grape); font-weight: 400; }
  .factors__introduction p { margin: 0 0 1.8rem; color: rgba(16, 21, 16, 0.66); font-size: clamp(0.98rem, 1.2vw, 1.14rem); }
  .factors__slider { margin-top: clamp(3rem, 5vw, 5rem); }
  .factors__meta { display: flex; align-items: center; justify-content: space-between; min-height: 3.5rem; padding-bottom: 0.9rem; border-bottom: 1px solid rgba(16, 21, 16, 0.2); color: rgba(16, 21, 16, 0.52); font-size: 0.64rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .factors__controls { display: flex; gap: 0.45rem; }
  .factors__controls button { display: grid; width: 3rem; height: 3rem; place-items: center; border: 1px solid rgba(16, 21, 16, 0.28); border-radius: 50%; background: transparent; color: var(--ink); transition: border-color 300ms ease, background 300ms ease, color 300ms ease, transform 450ms var(--ease-out), opacity 300ms ease; }
  .factors__controls button:first-child span { transform: rotate(180deg); }
  .factors__controls button span { display: block; margin-left: 0.1rem; font-size: 0.62rem; }
  .factors__controls button:hover:not(:disabled) { border-color: var(--grape); background: var(--grape); color: var(--chalk); transform: scale(1.06); }
  .factors__controls button:disabled { cursor: default; opacity: 0.28; }
  .factors__viewport { overflow-x: auto; overflow-y: hidden; margin-top: 1.25rem; outline: 0; overscroll-behavior-inline: contain; scroll-behavior: smooth; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .factors__viewport::-webkit-scrollbar { display: none; }
  .factors__viewport:focus-visible { outline: 1px solid rgba(91, 37, 52, 0.5); outline-offset: 0.4rem; }
  .factors__track { display: flex; width: max-content; height: clamp(32rem, 62svh, 36rem); align-items: stretch; gap: clamp(0.8rem, 1.4vw, 1.4rem); }
  .factor-card { display: flex; width: clamp(20rem, 27vw, 28rem); min-width: 0; height: 100%; flex: 0 0 auto; scroll-snap-align: start; flex-direction: column; overflow: hidden; border: 1px solid rgba(16, 21, 16, 0.16); background: #f4efe6; transition: transform 800ms var(--ease-out), box-shadow 600ms ease, opacity 900ms var(--ease-out), filter 900ms var(--ease-out); }
  .factor-card:hover { transform: translateY(-0.4rem); box-shadow: 0 1.8rem 4.5rem rgba(35, 28, 22, 0.12); }
  .factor-card__media { position: relative; overflow: hidden; flex: 0 0 39%; background: var(--forest); }
  .factor-card__media::after { position: absolute; inset: 0; content: ''; background: linear-gradient(180deg, rgba(10, 15, 11, 0.06), rgba(10, 15, 11, 0.42)); pointer-events: none; }
  .factor-card__media :global(img) { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.78) contrast(1.04); transition: transform 1.2s var(--ease-out), filter 700ms ease; }
  .factor-card:hover .factor-card__media :global(img) { transform: scale(1.045); filter: saturate(1) contrast(1.02); }
  .factor-card__media > span { position: absolute; z-index: 2; right: 1rem; bottom: 0.9rem; color: rgba(255, 255, 255, 0.82); font-size: 0.62rem; letter-spacing: 0.14em; }
  .factor-card__body { display: flex; min-height: 0; flex: 1; flex-direction: column; padding: clamp(1.25rem, 2.2vw, 2rem); }
  .factor-card h3 { min-height: 2em; margin: 0; font-family: var(--font-display); font-size: clamp(1.85rem, 2.5vw, 2.8rem); font-weight: 400; letter-spacing: -0.045em; line-height: 1; }
  .factor-card__copy { display: grid; gap: clamp(0.7rem, 1.4vh, 1.1rem); margin-top: clamp(1.1rem, 2.2vh, 1.7rem); }
  .factor-card__copy > div { padding-top: 0.7rem; border-top: 1px solid rgba(16, 21, 16, 0.17); }
  .factor-card__copy span { color: var(--grape); font-size: 0.56rem; font-weight: 650; letter-spacing: 0.13em; text-transform: uppercase; }
  .factor-card__copy p { margin: 0.45rem 0 0; color: rgba(16, 21, 16, 0.67); font-size: clamp(0.73rem, 1.25vh, 0.86rem); line-height: 1.45; }
  @media (max-width: 900px) { .factors__header { grid-template-columns: 1fr; gap: 2rem; } .factors__introduction { max-width: 38rem; } .factor-card { width: min(78vw, 26rem); } }
  @media (max-width: 560px) { .factors__controls button { width: 2.75rem; height: 2.75rem; } .factors__track { height: clamp(31rem, 67svh, 34rem); } .factor-card { width: min(84vw, 24rem); } .factor-card__media { flex-basis: 34%; } .factor-card h3 { min-height: 0; } }
  @media (prefers-reduced-motion: reduce) { .factors__viewport { scroll-behavior: auto; } .factor-card { transform: none !important; } }
</style>
