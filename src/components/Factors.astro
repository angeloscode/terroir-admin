---
const factors = [
  {
    title: 'Температурная инерция',
    mechanism: 'Вода нагревается и остывает медленнее суши, поэтому у побережья море может сглаживать часть температурных колебаний.',
    expression: 'Возможное выражение — более ровный ход созревания и баланс зрелости со свежестью.',
    mark: 'Δt',
  },
  {
    title: 'Воздушные массы',
    mechanism: 'Перенос воздуха со стороны моря может менять температурный и влажностный фон. Сила эффекта зависит от погоды и положения участка.',
    expression: 'При определённых условиях созревание может идти менее стремительно.',
    mark: '↝',
  },
  {
    title: 'Бризовая циркуляция',
    mechanism: 'Разница в нагреве воды и суши может создавать суточное движение воздуха между морем и берегом.',
    expression: 'Один из факторов, способных поддерживать ясность ароматики и живой баланс.',
    mark: '⇄',
  },
  {
    title: 'Влажность',
    mechanism: 'Влажность влияет на испарение влаги лозой и состояние виноградника, но требует точного управления участком.',
    expression: 'Прямого вкусового маркера нет: влияние проявляется через ход созревания.',
    mark: 'φ',
  },
  {
    title: 'Ветер и вентиляция',
    mechanism: 'Движение воздуха помогает просыханию растительного покрова и меняет водный режим лозы. Избыток ветра способен создавать стресс.',
    expression: 'При сбалансированном воздействии профиль вина может ощущаться более собранным.',
    mark: '≋',
  },
  {
    title: 'Продолжительность сезона',
    mechanism: 'Более широкое окно подходящих температур даёт больше возможностей для выбора срока сбора.',
    expression: 'Это позволяет точнее соотнести зрелость, свежесть и структуру — без гарантированного результата.',
    mark: '◒',
  },
  {
    title: 'Рельеф и высота',
    mechanism: 'Высота, форма склона и экспозиция меняют получение света и движение воздуха, делая влияние моря локальным.',
    expression: 'Поэтому разные профили вина возможны даже у расположенных рядом участков.',
    mark: '⌁',
  },
];
---

<section class="factors" id="science" aria-labelledby="factors-title">
  <div class="factors__header shell" data-reveal>
    <div>
      <p class="eyebrow">Научная основа</p>
      <h2 class="section-title" id="factors-title">Как место формирует<br /><em>характер вина.</em></h2>
    </div>
    <div class="factors__introduction">
      <p>
        Терруар действует не по одному параметру. Ниже — семь связей, через которые среда может влиять
        на лозу и созревание винограда.
      </p>
      <a class="text-link" href="#journal">Научная основа</a>
    </div>
  </div>

  <div class="factors__rail shell" data-factor-rail data-reveal>
    {factors.map((factor, index) => (
      <article class:list={['factor-card', { 'is-active': index === 0 }]} data-factor-card>
        <button
          class="factor-card__trigger"
          type="button"
          aria-expanded={index === 0 ? 'true' : 'false'}
          aria-controls={`factor-panel-${index + 1}`}
          data-factor-trigger
        >
          <span class="factor-card__number">{String(index + 1).padStart(2, '0')}</span>
          <span class="factor-card__title">{factor.title}</span>
          <span class="factor-card__plus" aria-hidden="true">+</span>
        </button>
        <div class="factor-card__content" id={`factor-panel-${index + 1}`} data-factor-panel>
          <span class="factor-card__mark" aria-hidden="true">{factor.mark}</span>
          <div>
            <p class="factor-card__label">Механизм</p>
            <p>{factor.mechanism}</p>
          </div>
          <div>
            <p class="factor-card__label">Возможное выражение</p>
            <p>{factor.expression}</p>
          </div>
        </div>
      </article>
    ))}
  </div>

  <div class="factors__note shell" data-reveal>
    <span>Важно</span>
    <p>Это связи, а не готовые формулы вкуса. Для каждого терруара они проверяются отдельно.</p>
  </div>
</section>

<script>
  const rail = document.querySelector<HTMLElement>('[data-factor-rail]');
  const cards = [...(rail?.querySelectorAll<HTMLElement>('[data-factor-card]') || [])];

  const activate = (next: HTMLElement) => {
    cards.forEach((card) => {
      const active = card === next;
      card.classList.toggle('is-active', active);
      card.querySelector<HTMLButtonElement>('[data-factor-trigger]')?.setAttribute('aria-expanded', String(active));
    });
  };

  cards.forEach((card, index) => {
    const trigger = card.querySelector<HTMLButtonElement>('[data-factor-trigger]');
    trigger?.addEventListener('click', () => activate(card));
    trigger?.addEventListener('keydown', (event) => {
      if (!['ArrowRight', 'ArrowLeft', 'ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const forward = ['ArrowRight', 'ArrowDown'].includes(event.key);
      const targetIndex = event.key === 'Home'
        ? 0
        : event.key === 'End'
          ? cards.length - 1
          : (index + (forward ? 1 : -1) + cards.length) % cards.length;
      activate(cards[targetIndex]);
      cards[targetIndex]?.querySelector<HTMLButtonElement>('[data-factor-trigger]')?.focus();
    });
  });
</script>

<style>
  .factors {
    position: relative;
    overflow: hidden;
    padding-block: var(--section-space);
    background: var(--ink);
    color: var(--chalk);
  }

  .factors::after {
    position: absolute;
    top: 6rem;
    right: -9rem;
    width: 25rem;
    height: 25rem;
    border: 1px solid rgba(247, 243, 234, 0.09);
    border-radius: 50%;
    content: '';
    box-shadow: 0 0 0 3rem rgba(247, 243, 234, 0.018), 0 0 0 6rem rgba(247, 243, 234, 0.018);
  }

  .factors__header {
    position: relative;
    z-index: 1;
    display: grid;
    align-items: end;
    grid-template-columns: minmax(0, 1.55fr) minmax(20rem, 0.45fr);
    gap: 4rem;
  }

  .factors h2 em {
    color: var(--clay);
    font-weight: 400;
  }

  .factors__introduction p {
    margin-bottom: 2rem;
    color: rgba(247, 243, 234, 0.68);
    font-size: 1rem;
  }

  .factors__rail {
    position: relative;
    z-index: 1;
    display: flex;
    height: min(37rem, 64vw);
    min-height: 32rem;
    gap: 1px;
    margin-top: clamp(4rem, 8vw, 8rem);
    padding-inline: var(--gutter);
  }

  .factor-card {
    position: relative;
    min-width: 4.2rem;
    overflow: hidden;
    flex: 0.62 1 0;
    border: 1px solid rgba(247, 243, 234, 0.17);
    background:
      linear-gradient(180deg, rgba(247, 243, 234, 0.025), transparent),
      var(--ink-soft);
    transition: flex 750ms var(--ease-out), background 500ms ease;
  }

  .factor-card::before {
    position: absolute;
    inset: 0;
    content: '';
    opacity: 0;
    background:
      radial-gradient(circle at 80% 20%, rgba(189, 103, 73, 0.24), transparent 35%),
      repeating-linear-gradient(165deg, transparent 0 22px, rgba(247, 243, 234, 0.035) 23px 24px);
    transition: opacity 600ms ease;
  }

  .factor-card.is-active {
    flex: 4.2 1 0;
    background-color: #202a22;
  }

  .factor-card.is-active::before {
    opacity: 1;
  }

  .factor-card__trigger {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: flex;
    width: 100%;
    align-items: center;
    flex-direction: column;
    gap: 1.1rem;
    border: 0;
    padding: 1.3rem 1rem;
    background: transparent;
    color: inherit;
    text-align: left;
  }

  .factor-card__number {
    align-self: flex-start;
    color: var(--clay);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.15em;
  }

  .factor-card__title {
    margin-block: auto;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.6vw, 1.5rem);
    line-height: 1.15;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .factor-card__plus {
    align-self: flex-start;
    font-size: 1.5rem;
    font-weight: 250;
    line-height: 1;
  }

  .factor-card__content {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: grid;
    visibility: hidden;
    align-content: end;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding: clamp(5rem, 8vw, 8rem) clamp(1.5rem, 3.2vw, 3.5rem) clamp(1.8rem, 3vw, 3rem);
    opacity: 0;
    transform: translateY(1.5rem);
    transition: opacity 350ms ease 180ms, transform 500ms var(--ease-out) 180ms, visibility 350ms;
  }

  .factor-card.is-active .factor-card__trigger {
    height: auto;
    inset: 0 0 auto;
    align-items: flex-start;
    flex-direction: row;
    padding: 1.5rem clamp(1.5rem, 3.2vw, 3.5rem);
    pointer-events: auto;
  }

  .factor-card.is-active .factor-card__title {
    margin: 0;
    font-size: clamp(1.45rem, 2.7vw, 3rem);
    writing-mode: horizontal-tb;
    transform: none;
  }

  .factor-card.is-active .factor-card__number {
    padding-top: 0.45rem;
  }

  .factor-card.is-active .factor-card__plus {
    margin-left: auto;
    transform: rotate(45deg);
  }

  .factor-card.is-active .factor-card__content {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  .factor-card__mark {
    position: absolute;
    top: 30%;
    right: 8%;
    color: rgba(247, 243, 234, 0.12);
    font-family: var(--font-display);
    font-size: clamp(7rem, 14vw, 14rem);
    line-height: 1;
  }

  .factor-card__content > div {
    position: relative;
    padding-top: 1rem;
    border-top: 1px solid rgba(247, 243, 234, 0.2);
  }

  .factor-card__content p:not(.factor-card__label) {
    margin: 0;
    color: rgba(247, 243, 234, 0.76);
    font-size: clamp(0.8rem, 1.05vw, 1rem);
  }

  .factor-card__label {
    margin: 0 0 0.8rem;
    color: var(--clay);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .factors__note {
    display: grid;
    grid-template-columns: minmax(5rem, 0.25fr) 1fr;
    gap: 2rem;
    margin-top: 2rem;
    color: rgba(247, 243, 234, 0.6);
  }

  .factors__note span {
    color: var(--clay);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .factors__note p {
    max-width: 44rem;
    margin: 0;
    font-size: 0.75rem;
  }

  @media (max-width: 960px) {
    .factors__header {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .factors__introduction {
      max-width: 36rem;
    }

    .factors__rail {
      height: auto;
      min-height: 0;
      flex-direction: column;
    }

    .factor-card,
    .factor-card.is-active {
      min-width: 0;
      flex: none;
    }

    .factor-card__trigger,
    .factor-card.is-active .factor-card__trigger {
      position: relative;
      inset: auto;
      display: grid;
      min-height: 4.9rem;
      align-items: center;
      grid-template-columns: 2.2rem 1fr auto;
      padding: 1rem 1.1rem;
    }

    .factor-card__number,
    .factor-card.is-active .factor-card__number {
      align-self: center;
      padding: 0;
    }

    .factor-card__title,
    .factor-card.is-active .factor-card__title {
      margin: 0;
      font-size: clamp(1.25rem, 4vw, 1.8rem);
      writing-mode: horizontal-tb;
      transform: none;
    }

    .factor-card__plus,
    .factor-card.is-active .factor-card__plus {
      align-self: center;
      margin: 0;
    }

    .factor-card__content {
      position: relative;
      inset: auto;
      display: none;
      padding: 1rem 1.1rem 2rem 4.3rem;
    }

    .factor-card.is-active .factor-card__content {
      display: grid;
    }

    .factor-card__mark {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .factor-card__content {
      grid-template-columns: 1fr;
    }

    .factors__note {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
