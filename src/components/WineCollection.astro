---
import { Image } from 'astro:assets';
import bottles from '../assets/wine-bottles-placeholder.png';

const wines = [
  { index: '01', terroir: 'Мезыбь', kind: 'Тип уточняется', note: 'Технический паспорт готовится' },
  { index: '02', terroir: 'Мезыбь', kind: 'Тип уточняется', note: 'Описание появится после дегустации' },
  { index: '03', terroir: 'Скалистый берег', kind: 'Тип уточняется', note: 'Сортовой состав уточняется' },
  { index: '04', terroir: 'Скалистый берег', kind: 'Тип уточняется', note: 'Данные урожая готовятся' },
];
---

<section class="wines" id="wines" aria-labelledby="wines-title">
  <div class="wines__header shell" data-reveal>
    <p class="eyebrow">Коллекция авторских вин</p>
    <h2 class="section-title" id="wines-title">Сначала место.<br /><em>Затем вино.</em></h2>
    <p class="section-lead">
      Каждое вино раскрывается через происхождение: участок, сезон, сортовой состав и решения винодела.
    </p>
  </div>

  <div class="wines__stage shell" data-wine-stage data-reveal>
    <div class="wines__visual">
      <span class="wines__large-index" data-wine-large-index>01</span>
      <Image
        src={bottles}
        widths={[640, 900, 1200]}
        sizes="(max-width: 900px) 100vw, 56vw"
        format="webp"
        quality={86}
        alt="Три бутылки с временным дизайном этикеток"
        loading="lazy"
      />
      <span class="placeholder-tag">Временный дизайн бутылок</span>
      <div class="wines__origin">
        <span>Терруар</span>
        <strong data-wine-origin>Мезыбь</strong>
      </div>
    </div>

    <div class="wines__catalogue">
      <div class="wines__catalogue-head">
        <span>Коллекционный реестр</span>
        <span>4 позиции / данные готовятся</span>
      </div>
      <div class="wines__active-copy" aria-live="polite">
        <p class="wines__active-kicker">Вино <span data-wine-number>01</span></p>
        <h3 data-wine-name>Название готовится</h3>
        <p data-wine-note>Технический паспорт готовится</p>
      </div>
      <div class="wines__list" role="group" aria-label="Вина коллекции">
        {wines.map((wine, index) => (
          <button
            class:list={['wine-row', { 'is-active': index === 0 }]}
            type="button"
            data-wine-row
            data-index={wine.index}
            data-terroir={wine.terroir}
            data-kind={wine.kind}
            data-note={wine.note}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            <span>{wine.index}</span>
            <span>Название готовится<small>{wine.terroir}</small></span>
            <span>{wine.kind}</span>
            <span aria-hidden="true">↗</span>
          </button>
        ))}
      </div>
      <div class="wines__actions">
        <a class="text-link" href="#map">Связать с терруаром</a>
        <a class="wines__quiet-link" href="#buy">Где найти</a>
      </div>
    </div>
  </div>
</section>

<script>
  const wineStage = document.querySelector<HTMLElement>('[data-wine-stage]');
  const rows = wineStage?.querySelectorAll<HTMLButtonElement>('[data-wine-row]');
  const largeIndex = wineStage?.querySelector<HTMLElement>('[data-wine-large-index]');
  const number = wineStage?.querySelector<HTMLElement>('[data-wine-number]');
  const origin = wineStage?.querySelector<HTMLElement>('[data-wine-origin]');
  const note = wineStage?.querySelector<HTMLElement>('[data-wine-note]');

  rows?.forEach((row) => row.addEventListener('click', () => {
    rows.forEach((item) => {
      const active = item === row;
      item.classList.toggle('is-active', active);
      item.setAttribute('aria-pressed', String(active));
    });
    if (largeIndex) largeIndex.textContent = row.dataset.index || '';
    if (number) number.textContent = row.dataset.index || '';
    if (origin) origin.textContent = row.dataset.terroir || '';
    if (note) note.textContent = row.dataset.note || '';
  }));
</script>

<style>
  .wines {
    position: relative;
    overflow: hidden;
    padding-block: var(--section-space);
    background: var(--grape);
    color: var(--chalk);
  }

  .wines::before {
    position: absolute;
    inset: 0;
    content: '';
    opacity: 0.13;
    background-image:
      linear-gradient(rgba(247, 243, 234, 0.28) 1px, transparent 1px),
      linear-gradient(90deg, rgba(247, 243, 234, 0.28) 1px, transparent 1px);
    background-size: 25vw 25vw;
  }

  .wines__header,
  .wines__stage {
    position: relative;
    z-index: 1;
  }

  .wines__header em {
    color: #d9aa98;
    font-weight: 400;
  }

  .wines__stage {
    display: grid;
    align-items: stretch;
    grid-template-columns: minmax(0, 1.05fr) minmax(23rem, 0.75fr);
    gap: clamp(2rem, 5vw, 6rem);
    margin-top: clamp(4rem, 8vw, 8rem);
  }

  .wines__visual {
    position: relative;
    min-height: 44rem;
    overflow: hidden;
    background: #211712;
  }

  .wines__visual::after {
    position: absolute;
    inset: 0;
    content: '';
    box-shadow: inset 0 0 7rem rgba(16, 10, 8, 0.6);
    pointer-events: none;
  }

  .wines__visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }

  .wines__stage:has(.wine-row:hover) .wines__visual :global(img) {
    transform: scale(1.025);
  }

  .wines__large-index {
    position: absolute;
    z-index: 2;
    top: 1.5rem;
    left: 1.5rem;
    color: rgba(247, 243, 234, 0.8);
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 8rem);
    letter-spacing: -0.08em;
    line-height: 1;
    transition: opacity 240ms ease;
  }

  .wines__visual .placeholder-tag {
    position: absolute;
    z-index: 2;
    top: 1.5rem;
    right: 1.5rem;
    background: rgba(16, 21, 16, 0.58);
  }

  .wines__origin {
    position: absolute;
    z-index: 2;
    right: 1.5rem;
    bottom: 1.5rem;
    left: 1.5rem;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(247, 243, 234, 0.35);
  }

  .wines__origin span {
    font-size: 0.62rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .wines__origin strong {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2.7rem);
    font-weight: 400;
  }

  .wines__catalogue {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .wines__catalogue-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line-light);
    color: rgba(247, 243, 234, 0.58);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .wines__active-copy {
    min-height: 16rem;
    padding-block: clamp(2rem, 4vw, 4rem);
  }

  .wines__active-kicker {
    margin-bottom: 0.8rem;
    color: #d9aa98;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .wines__active-copy h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4vw, 4.7rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .wines__active-copy > p:last-child {
    margin: 1.4rem 0 0;
    color: rgba(247, 243, 234, 0.64);
  }

  .wines__list {
    border-top: 1px solid var(--line-light);
  }

  .wine-row {
    display: grid;
    width: 100%;
    min-height: 5.2rem;
    align-items: center;
    grid-template-columns: 2.3rem 1fr auto 1.2rem;
    gap: 1rem;
    border: 0;
    border-bottom: 1px solid var(--line-light);
    padding: 0;
    background: transparent;
    color: rgba(247, 243, 234, 0.64);
    text-align: left;
    transition: color 250ms ease, padding 350ms var(--ease-out), background 250ms ease;
  }

  .wine-row:hover,
  .wine-row.is-active {
    padding-inline: 0.8rem;
    background: rgba(247, 243, 234, 0.06);
    color: var(--chalk);
  }

  .wine-row > span:first-child,
  .wine-row > span:nth-child(3) {
    font-size: 0.59rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .wine-row > span:nth-child(2) {
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  .wine-row small {
    display: block;
    margin-top: 0.2rem;
    color: rgba(247, 243, 234, 0.48);
    font-family: var(--font-body);
    font-size: 0.54rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .wines__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: auto;
    padding-top: 2rem;
  }

  .wines__quiet-link {
    color: rgba(247, 243, 234, 0.65);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 960px) {
    .wines__stage {
      grid-template-columns: 1fr;
    }

    .wines__visual {
      min-height: 0;
      aspect-ratio: 4 / 4.4;
    }
  }

  @media (max-width: 620px) {
    .wines__visual {
      aspect-ratio: 4 / 5;
    }

    .wines__catalogue-head span:last-child,
    .wine-row > span:nth-child(3) {
      display: none;
    }

    .wine-row {
      grid-template-columns: 2.2rem 1fr 1rem;
    }

    .wines__actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
