---
import poster from '../assets/video-vineyard-wide.png';
---

<section class="video-story" id="top" data-video-story aria-label="Введение в проект">
  <div class="video-story__stage" data-video-stage data-phase="hero">
    <video
      class="video-story__media"
      data-story-video
      muted
      playsinline
      loop
      preload="metadata"
      poster={poster.src}
      tabindex="-1"
      aria-hidden="true"
    >
      <source src="/media/hero-vineyards.mp4" type="video/mp4" />
    </video>
    <div class="video-story__scrim"></div>
    <div class="video-story__grid" aria-hidden="true"></div>

    <div class="video-story__hero shell" data-hero-copy>
      <div class="video-story__folio">
        <span>Атлас вкуса</span>
        <span>Полевая запись / 001</span>
      </div>
      <div class="video-story__headline">
        <div class="video-story__title-group">
          <p class="eyebrow">Коллекция авторских вин</p>
          <h1 class="display-title" tabindex="-1" data-hero-primary>Вино —<br /><em>вкус места.</em></h1>
        </div>
        <div class="video-story__intro">
          <p>Мы исследуем, как почва, рельеф, свет, ветер и близость моря участвуют в формировании характера вина.</p>
          <div class="video-story__actions">
            <a class="text-link" href="#wines">Исследовать коллекцию</a>
            <a class="video-story__secondary" href="#about">О проекте</a>
          </div>
        </div>
      </div>
      <div class="video-story__scroll" aria-hidden="true">
        <span>Смотреть историю</span>
        <i></i>
      </div>
    </div>

    <div class="video-story__phrases shell" aria-live="off">
      <p data-story-phrase="one">Земля <em>формирует.</em></p>
      <p data-story-phrase="two">Лоза <em>запоминает.</em></p>
      <p data-story-phrase="three">Вино <em>передаёт.</em></p>
    </div>

    <div class="video-story__manifesto shell" id="about" data-story-manifesto>
      <p class="eyebrow">Манифест коллекции</p>
      <p class="video-story__manifesto-text">
        Мы собираем эту коллекцию, чтобы различия между местами можно было не только увидеть, но и
        <em>почувствовать.</em> Каждый участок — собственное сочетание земли, света, воздуха и времени.
      </p>
      <p class="video-story__manifesto-note">Место становится вкусом.</p>
    </div>

    <div class="video-story__progress" aria-hidden="true"><span data-story-progress></span></div>
  </div>
</section>

<script>
  const story = document.querySelector<HTMLElement>('[data-video-story]');
  const stage = story?.querySelector<HTMLElement>('[data-video-stage]');
  const video = story?.querySelector<HTMLVideoElement>('[data-story-video]');
  const progressLine = story?.querySelector<HTMLElement>('[data-story-progress]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let ticking = false;

  const setPhase = (progress: number) => {
    if (!stage) return;
    const phase = progress < 0.19
      ? 'hero'
      : progress < 0.36
        ? 'one'
        : progress < 0.51
          ? 'two'
          : progress < 0.66
            ? 'three'
            : 'manifesto';
    stage.dataset.phase = phase;
    stage.style.setProperty('--story-progress', progress.toFixed(4));
    if (progressLine) progressLine.style.transform = `scaleY(${progress})`;
  };

  const update = () => {
    ticking = false;
    if (!story || reduceMotion.matches) return;
    const rect = story.getBoundingClientRect();
    const distance = Math.max(1, story.offsetHeight - window.innerHeight);
    setPhase(Math.min(1, Math.max(0, -rect.top / distance)));
  };

  const requestUpdate = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  };

  const primeHeroFrame = () => {
    if (!video || video.dataset.openingPrimed === 'true' || !Number.isFinite(video.duration)) return;
    video.currentTime = Math.min(1.75, Math.max(0, video.duration - 0.1));
    video.dataset.openingPrimed = 'true';
  };

  const managePlayback = () => {
    if (!video) return;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    if (reduceMotion.matches || saveData || document.documentElement.classList.contains('age-locked')) {
      video.pause();
      return;
    }
    if (video.readyState >= HTMLMediaElement.HAVE_METADATA) primeHeroFrame();
    else video.addEventListener('loadedmetadata', primeHeroFrame, { once: true });
    video.play().catch(() => undefined);
  };

  const observer = new IntersectionObserver(([entry]) => {
    if (!video) return;
    if (entry.isIntersecting) managePlayback(); else video.pause();
  }, { rootMargin: '20% 0px', threshold: 0.01 });

  if (story) observer.observe(story);
  window.addEventListener('scroll', requestUpdate, { passive: true });
  window.addEventListener('resize', requestUpdate, { passive: true });
  window.addEventListener('terroir:age-verified', managePlayback);
  document.addEventListener('visibilitychange', () => document.hidden ? video?.pause() : managePlayback());
  reduceMotion.addEventListener('change', () => { managePlayback(); requestUpdate(); });
  requestUpdate();
</script>

<style>
  .video-story {
    position: relative;
    height: 500svh;
    background: var(--ink);
  }

  .video-story__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }

  .video-story__media,
  .video-story__scrim,
  .video-story__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .video-story__media {
    z-index: -3;
    object-fit: cover;
    filter: saturate(0.72) contrast(1.05) brightness(0.86);
    transform: scale(calc(1.035 + var(--story-progress, 0) * 0.025));
    transition: filter 900ms ease;
  }

  .video-story__scrim {
    z-index: -2;
    background:
      linear-gradient(90deg, rgba(8, 12, 8, 0.76) 0%, rgba(8, 12, 8, 0.28) 52%, rgba(8, 12, 8, 0.25) 100%),
      linear-gradient(0deg, rgba(8, 12, 8, 0.92) 0%, transparent 52%, rgba(8, 12, 8, 0.22) 100%);
    transition: background 800ms ease;
  }

  .video-story__grid {
    z-index: -1;
    opacity: 0.13;
    background-image:
      linear-gradient(rgba(247, 243, 234, 0.42) 1px, transparent 1px),
      linear-gradient(90deg, rgba(247, 243, 234, 0.42) 1px, transparent 1px);
    background-position: center;
    background-size: 25vw 25vh;
  }

  .video-story__hero,
  .video-story__phrases,
  .video-story__manifesto {
    position: absolute;
    inset: 0;
    transition: opacity 600ms var(--ease-out), transform 800ms var(--ease-out);
  }

  .video-story__hero {
    display: flex;
    align-items: flex-end;
    padding-top: 8rem;
    padding-bottom: clamp(2.5rem, 6vh, 5rem);
  }

  .video-story__folio {
    position: absolute;
    top: 8.4rem;
    right: var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    color: rgba(247, 243, 234, 0.58);
    font-size: 0.58rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .video-story__headline {
    display: grid;
    width: 100%;
    align-items: end;
    grid-template-columns: minmax(0, 1.55fr) minmax(17rem, 0.55fr);
    gap: 3rem;
  }

  .video-story__title-group {
    min-width: 0;
  }

  .video-story h1 {
    margin-top: 1rem;
    color: var(--chalk);
    font-size: clamp(4.6rem, 10vw, 10.5rem);
  }

  .video-story h1 em {
    color: var(--limestone);
    font-weight: 400;
  }

  .video-story__intro {
    padding-bottom: 0.5rem;
  }

  .video-story__intro > p {
    max-width: 32rem;
    margin-bottom: 2rem;
    color: rgba(247, 243, 234, 0.8);
    font-size: clamp(0.95rem, 1.3vw, 1.25rem);
    line-height: 1.55;
  }

  .video-story__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .video-story__secondary {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: rgba(247, 243, 234, 0.68);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .video-story__scroll {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(2.5rem, 6vh, 5rem);
    display: none;
    align-items: center;
    gap: 0.8rem;
    color: rgba(247, 243, 234, 0.6);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .video-story__scroll i {
    position: relative;
    width: 1px;
    height: 2.8rem;
    overflow: hidden;
    background: rgba(247, 243, 234, 0.25);
  }

  .video-story__scroll i::after {
    position: absolute;
    inset: 0;
    content: '';
    transform: translateY(-100%);
    background: var(--clay);
    animation: scroll-cue 2s var(--ease-out) infinite;
  }

  .video-story__phrases {
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  .video-story__phrases p {
    position: absolute;
    margin: 0;
    opacity: 0;
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 11rem);
    letter-spacing: -0.06em;
    line-height: 0.95;
    text-align: center;
    transform: translateY(2rem);
    transition: opacity 600ms var(--ease-out), transform 800ms var(--ease-out);
  }

  .video-story__phrases em,
  .video-story__manifesto em {
    color: var(--clay);
    font-weight: 400;
  }

  .video-story__manifesto {
    display: flex;
    visibility: hidden;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    transform: translateY(2.5rem);
  }

  .video-story__manifesto-text {
    max-width: 72rem;
    margin: 1.5rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.8vw, 5.4rem);
    letter-spacing: -0.045em;
    line-height: 1.13;
  }

  .video-story__manifesto-note {
    margin: 2rem 0 0 auto;
    color: rgba(247, 243, 234, 0.62);
    font-size: 0.73rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .video-story__progress {
    position: absolute;
    z-index: 2;
    top: 50%;
    right: 1.2rem;
    width: 1px;
    height: 22vh;
    transform: translateY(-50%);
    background: rgba(247, 243, 234, 0.2);
  }

  .video-story__progress span {
    position: absolute;
    inset: 0;
    transform: scaleY(0);
    transform-origin: top;
    background: var(--clay);
  }

  .video-story__stage:not([data-phase='hero']) .video-story__hero {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-2rem);
  }

  .video-story__stage[data-phase='one'] [data-story-phrase='one'],
  .video-story__stage[data-phase='two'] [data-story-phrase='two'],
  .video-story__stage[data-phase='three'] [data-story-phrase='three'] {
    opacity: 1;
    transform: translateY(0);
  }

  .video-story__stage[data-phase='manifesto'] .video-story__manifesto {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  .video-story__stage[data-phase='manifesto'] .video-story__scrim {
    background: rgba(8, 12, 8, 0.75);
  }

  @keyframes scroll-cue {
    0% { transform: translateY(-100%); }
    55%, 100% { transform: translateY(100%); }
  }

  @media (max-width: 900px) {
    .video-story__headline {
      display: block;
    }

    .video-story__intro {
      max-width: 31rem;
      margin-top: 1.5rem;
    }

    .video-story__folio {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .video-story {
      height: 430svh;
    }

    .video-story__media {
      object-position: 62% center;
    }

    .video-story__hero {
      padding-bottom: max(1.6rem, env(safe-area-inset-bottom));
    }

    .video-story h1 {
      font-size: clamp(3.9rem, 18vw, 6rem);
    }

    .video-story__intro > p {
      max-width: 22rem;
      margin-bottom: 1.3rem;
      font-size: 0.92rem;
    }

    .video-story__actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.3rem;
    }

    .video-story__secondary {
      min-height: 2.5rem;
    }

    .video-story__phrases p {
      font-size: clamp(3rem, 15vw, 5rem);
    }

    .video-story__manifesto-text {
      font-size: clamp(2rem, 9.5vw, 3.6rem);
    }

    .video-story__manifesto-note {
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .video-story {
      height: auto;
    }

    .video-story__stage {
      position: relative;
      height: auto;
      min-height: 100svh;
      overflow: visible;
      background: var(--ink) url('../assets/video-vineyard-wide.png') center / cover no-repeat;
    }

    .video-story__media,
    .video-story__progress,
    .video-story__scroll {
      display: none;
    }

    .video-story__hero,
    .video-story__phrases,
    .video-story__manifesto {
      position: relative;
      inset: auto;
      min-height: 100svh;
      opacity: 1 !important;
      visibility: visible !important;
      transform: none !important;
    }

    .video-story__phrases {
      display: flex;
      min-height: auto;
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
      padding-block: 5rem;
    }

    .video-story__phrases p {
      position: relative;
      opacity: 1;
      text-align: left;
      transform: none;
    }
  }
</style>
