  .map__sea-shadow {
    fill: rgba(0, 0, 0, 0.46);
  }

  .map__sea {
    stroke: rgba(238, 233, 223, 0.08);
    stroke-width: 8;
  }

  .map__shoreline {
    fill: none;
    stroke: var(--map-limestone);
    stroke-width: 1.35;
    vector-effect: non-scaling-stroke;
  }

  .map__current {
    fill: none;
    stroke: rgba(183, 92, 61, 0.32);
    stroke-dasharray: 3 7;
    stroke-linecap: round;
    stroke-width: 1.15;
    vector-effect: non-scaling-stroke;
  }

  .map__current--short {
    stroke: rgba(238, 233, 223, 0.16);
  }

  .map__compass circle,
  .map__compass path {
    fill: none;
    stroke: rgba(238, 233, 223, 0.2);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .map__compass .map__compass-north {
    fill: var(--map-clay);
    stroke: none;
  }

  .map__compass text {
    fill: rgba(238, 233, 223, 0.52);
    font: 500 11px/1 var(--map-ui);
    text-anchor: middle;
  }

  .map__marker {
    position: absolute;
    z-index: 3;
    display: flex;
    gap: 0.75rem;
    align-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.45rem 0.65rem;
    border: 0;
    color: var(--map-limestone);
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .map__marker--mezyb {
    top: 36%;
    left: 60%;
  }

  .map__marker--rocky {
    top: 55%;
    left: 42%;
  }

  .map__marker-index {
    position: relative;
    display: grid;
    flex: 0 0 auto;
