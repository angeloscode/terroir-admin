<section id="map" class="map" aria-labelledby="map-title" data-terroir-map>
  <div class="map__heading">
    <div>
      <p class="map__eyebrow">География коллекции</p>
      <h2 id="map-title">Карта терруаров</h2>
    </div>

    <p class="map__introduction">
      Выберите место, чтобы увидеть связанные с ним вина. Карта собирает коллекцию
      вокруг происхождения — от участка к характеру вина.
    </p>
  </div>

  <form class="map__filters" role="search" aria-label="Поиск и фильтрация терруаров" data-map-filters>
    <label class="map__field map__field--search">
      <span>Поиск</span>
      <span class="map__input-wrap">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19">
          <circle cx="10.8" cy="10.8" r="6.7"></circle>
          <path d="m16 16 4.2 4.2"></path>
        </svg>
        <input
          type="search"
          name="query"
          placeholder="Название терруара"
          autocomplete="off"
          data-map-search
        />
      </span>
    </label>

    <label class="map__field">
      <span>Терруар</span>
      <span class="map__select-wrap">
        <select name="terroir" data-map-terroir>
          <option value="all">Все терруары</option>
          <option value="mezyb">Мезыбь</option>
          <option value="rocky-shore">Скалистый берег</option>
        </select>
        <svg aria-hidden="true" viewBox="0 0 16 10" width="12" height="8">
          <path d="m1 1 7 7 7-7"></path>
        </svg>
      </span>
    </label>

    <label class="map__field">
      <span>Тип вина</span>
      <span class="map__select-wrap">
        <select name="type" data-map-type>
          <option value="all">Все типы</option>
          <option value="unconfirmed">Тип уточняется</option>
          <option value="white">Белое</option>
          <option value="red">Красное</option>
          <option value="rose">Розовое</option>
          <option value="sparkling">Игристое</option>
        </select>
        <svg aria-hidden="true" viewBox="0 0 16 10" width="12" height="8">
          <path d="m1 1 7 7 7-7"></path>
        </svg>
      </span>
    </label>

    <button class="map__reset" type="reset" data-map-reset>
      <span>Сбросить</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17">
        <path d="M5.2 8A8 8 0 1 1 4 14"></path>
        <path d="M5 3.5V8h4.5"></path>
      </svg>
    </button>
  </form>

  <div class="map__body">
    <div class="map__canvas">
      <div class="map__canvas-meta" aria-hidden="true">
        <span>Черноморское побережье</span>
        <span>Условная схема · без масштаба</span>
      </div>

      <svg
        class="map__graphic"
        viewBox="0 0 920 560"
        role="img"
        aria-labelledby="map-graphic-title map-graphic-desc"
        preserveAspectRatio="xMidYMid meet"
      >
        <title id="map-graphic-title">Условная схема побережья Чёрного моря</title>
        <desc id="map-graphic-desc">
          Художественная схема с двумя интерактивными точками: Мезыбь и Скалистый берег.
          Схема не передаёт точные координаты и масштаб.
        </desc>
        <defs>
          <pattern id="field-grid" width="56" height="56" patternUnits="userSpaceOnUse">
            <path d="M56 0H0v56" fill="none" stroke="currentColor" stroke-width="0.7"></path>
          </pattern>
          <linearGradient id="sea-wash" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#202b20"></stop>
            <stop offset="0.55" stop-color="#131a14"></stop>
            <stop offset="1" stop-color="#0c110d"></stop>
          </linearGradient>
          <filter id="soft-shadow" x="-15%" y="-15%" width="130%" height="130%">
            <feGaussianBlur in="SourceAlpha" stdDeviation="12"></feGaussianBlur>
            <feOffset dy="9"></feOffset>
            <feComponentTransfer>
              <feFuncA type="linear" slope=".32"></feFuncA>
            </feComponentTransfer>
            <feMerge>
              <feMergeNode></feMergeNode>
              <feMergeNode in="SourceGraphic"></feMergeNode>
            </feMerge>
          </filter>
        </defs>

        <rect class="map__grid" width="920" height="560" fill="url(#field-grid)"></rect>

        <g class="map__contours" aria-hidden="true">
          <path d="M-20 107C120 54 205 105 317 70s218-76 351-28 173 21 284-14"></path>
          <path d="M-8 130c128-47 226 3 332-30s213-64 337-20 184 22 278-7"></path>
          <path d="M-13 467c123-40 209-13 300 22s187 53 297 15 230-22 357 20"></path>
          <path d="M-25 493c130-31 214-2 302 31s198 44 305 11 237-13 362 27"></path>
        </g>

        <path
          class="map__sea-shadow"
          d="M99 227c35-49 101-70 176-80 71-10 128-35 205-29 58 5 99 29 146 21 72-12 140 20 183 57 37 32 42 66 17 94-30 33-81 33-119 51-42 21-61 59-116 65-48 5-84-17-129-21-53-5-86 16-140 10-62-7-92-39-132-64-45-28-75-61-91-104Z"
          filter="url(#soft-shadow)"
        ></path>
        <path
          class="map__sea"
          d="M99 227c35-49 101-70 176-80 71-10 128-35 205-29 58 5 99 29 146 21 72-12 140 20 183 57 37 32 42 66 17 94-30 33-81 33-119 51-42 21-61 59-116 65-48 5-84-17-129-21-53-5-86 16-140 10-62-7-92-39-132-64-45-28-75-61-91-104Z"
          fill="url(#sea-wash)"
        ></path>
        <path
          class="map__shoreline"
          d="M99 227c35-49 101-70 176-80 71-10 128-35 205-29 58 5 99 29 146 21 72-12 140 20 183 57 37 32 42 66 17 94-30 33-81 33-119 51-42 21-61 59-116 65-48 5-84-17-129-21-53-5-86 16-140 10-62-7-92-39-132-64-45-28-75-61-91-104Z"
        ></path>
        <path class="map__current" d="M176 253c126-67 236-47 337-56 91-8 151-40 236 10"></path>
        <path class="map__current map__current--short" d="M266 328c90 34 182 24 263 4 73-18 128-32 196-10"></path>

        <g class="map__compass" aria-hidden="true" transform="translate(805 452)">
          <circle r="34"></circle>
          <path d="M0-26V26M-26 0h52"></path>
          <path class="map__compass-north" d="m0-27-5 13 5-3 5 3Z"></path>
          <text x="0" y="-43">С</text>
        </g>
      </svg>

      <button
        class="map__marker map__marker--mezyb is-active"
        type="button"
        data-terroir-target="mezyb"
        aria-controls="map-card-mezyb"
        aria-pressed="true"
      >
        <span class="map__marker-index" aria-hidden="true"></span>
        <span class="map__marker-copy">
          <strong>Мезыбь</strong>
          <small>Точка коллекции</small>
        </span>
      </button>

      <button
        class="map__marker map__marker--rocky"
        type="button"
        data-terroir-target="rocky-shore"
        aria-controls="map-card-rocky-shore"
        aria-pressed="false"
      >
        <span class="map__marker-index" aria-hidden="true"></span>
        <span class="map__marker-copy">
          <strong>Скалистый берег</strong>
          <small>Точка коллекции</small>
        </span>
      </button>

      <p class="map__disclaimer">
        Схема носит художественный характер. Точные географические данные будут
        опубликованы только после верификации.
      </p>
    </div>

    <aside class="map__results" aria-label="Терруары на карте">
      <div class="map__results-head">
        <p>Места коллекции</p>
        <p class="map__status" aria-live="polite" aria-atomic="true" data-map-status>
          Найдено: 2 из 2
        </p>
      </div>

      <ul class="map__list" data-map-list>
        <li
          id="map-card-mezyb"
          class="map__card is-active"
          data-terroir-card
          data-key="mezyb"
          data-type="unconfirmed"
          data-search="мезыбь терруар место коллекции данные уточняются"
        >
          <div class="map__card-topline">
            <span>Мезыбь</span>
            <span class="map__card-state">Данные уточняются</span>
          </div>
          <h3>Место, раскрытое через вино</h3>
          <p>
            Профиль участка и связанные вина появятся после подтверждения материалов
            проекта.
          </p>
          <button type="button" data-card-target="mezyb">
            <span>Выделить на схеме</span>
            <span aria-hidden="true">↗</span>
          </button>
        </li>

        <li
          id="map-card-rocky-shore"
          class="map__card"
          data-terroir-card
          data-key="rocky-shore"
          data-type="unconfirmed"
          data-search="скалистый берег терруар место коллекции данные уточняются"
        >
          <div class="map__card-topline">
            <span>Скалистый берег</span>
            <span class="map__card-state">Данные уточняются</span>
          </div>
          <h3>Характер конкретного места</h3>
          <p>
            Профиль участка и связанные вина появятся после подтверждения материалов
            проекта.
          </p>
          <button type="button" data-card-target="rocky-shore">
            <span>Выделить на схеме</span>
            <span aria-hidden="true">↗</span>
          </button>
        </li>
      </ul>

      <div class="map__empty" hidden data-map-empty>
        <span aria-hidden="true">∅</span>
        <h3>Ничего не найдено</h3>
        <p>Измените запрос или сбросьте фильтры, чтобы увидеть все терруары.</p>
        <button type="button" data-empty-reset>Показать все</button>
      </div>

      <p class="map__data-note">
        Фильтр по типу вина подготовлен к наполнению. До публикации подтверждённой
        коллекции типы вин не присваиваются.
      </p>
    </aside>
  </div>
</section>

<script>
  const mapRoot = document.querySelector<HTMLElement>('[data-terroir-map]');

  if (mapRoot) {
    const form = mapRoot.querySelector<HTMLFormElement>('[data-map-filters]');
    const search = mapRoot.querySelector<HTMLInputElement>('[data-map-search]');
    const terroirSelect = mapRoot.querySelector<HTMLSelectElement>('[data-map-terroir]');
    const typeSelect = mapRoot.querySelector<HTMLSelectElement>('[data-map-type]');
    const reset = mapRoot.querySelector<HTMLButtonElement>('[data-map-reset]');
    const emptyReset = mapRoot.querySelector<HTMLButtonElement>('[data-empty-reset]');
    const empty = mapRoot.querySelector<HTMLElement>('[data-map-empty]');
    const status = mapRoot.querySelector<HTMLElement>('[data-map-status]');
    const cards = Array.from(mapRoot.querySelectorAll<HTMLElement>('[data-terroir-card]'));
    const markers = Array.from(mapRoot.querySelectorAll<HTMLButtonElement>('[data-terroir-target]'));
    const cardButtons = Array.from(mapRoot.querySelectorAll<HTMLButtonElement>('[data-card-target]'));

    let activeKey: string | null = 'mezyb';

    const setActive = (key: string | null) => {
      activeKey = key;

      cards.forEach((card) => {
        const isActive = card.dataset.key === key && !card.hidden;
        card.classList.toggle('is-active', isActive);
      });

      markers.forEach((marker) => {
        const isActive = marker.dataset.terroirTarget === key;
        marker.classList.toggle('is-active', isActive);
        marker.setAttribute('aria-pressed', String(isActive));
      });
    };

    const applyFilters = () => {
      if (!search || !terroirSelect || !typeSelect || !empty || !status) return;

      const query = search.value.trim().toLocaleLowerCase('ru-RU');
      const terroir = terroirSelect.value;
      const type = typeSelect.value;
      const visibleKeys = new Set<string>();

      cards.forEach((card) => {
        const matchesQuery = !query || (card.dataset.search ?? '').includes(query);
        const matchesTerroir = terroir === 'all' || card.dataset.key === terroir;
        const matchesType = type === 'all' || card.dataset.type === type;
        const isVisible = matchesQuery && matchesTerroir && matchesType;

        card.hidden = !isVisible;
        if (isVisible && card.dataset.key) visibleKeys.add(card.dataset.key);
      });

      const firstVisibleKey = visibleKeys.values().next().value ?? null;
      if (!activeKey || !visibleKeys.has(activeKey)) setActive(firstVisibleKey);
      else setActive(activeKey);

      markers.forEach((marker) => {
        const isFiltered = !visibleKeys.has(marker.dataset.terroirTarget ?? '');
        marker.toggleAttribute('data-filtered', isFiltered);
      });

      empty.hidden = visibleKeys.size !== 0;
      status.textContent = visibleKeys.size === 0
        ? 'По заданным параметрам ничего не найдено'
        : `Найдено: ${visibleKeys.size} из ${cards.length}`;

      if (reset) reset.disabled = !query && terroir === 'all' && type === 'all';
    };

    const resetFilters = () => {
      if (search) search.value = '';
      if (terroirSelect) terroirSelect.value = 'all';
      if (typeSelect) typeSelect.value = 'all';
      setActive('mezyb');
      applyFilters();
    };

    form?.addEventListener('submit', (event) => event.preventDefault());
    form?.addEventListener('input', applyFilters);
    form?.addEventListener('change', applyFilters);
    form?.addEventListener('reset', () => requestAnimationFrame(resetFilters));
    emptyReset?.addEventListener('click', resetFilters);

    markers.forEach((marker) => {
      marker.addEventListener('click', () => {
        const key = marker.dataset.terroirTarget;
        if (!key || !terroirSelect || !typeSelect || !search) return;

        search.value = '';
        typeSelect.value = 'all';
        terroirSelect.value = key;
        applyFilters();
        setActive(key);
      });
    });

    cardButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const key = button.dataset.cardTarget;
        if (key) setActive(key);
      });
    });

    applyFilters();
  }
</script>

<style>
  .map {
    --map-ink: var(--color-ink, #101510);
    --map-vineyard: var(--color-vineyard, #172018);
    --map-grape: var(--color-grape, #5b2534);
    --map-clay: var(--color-clay, #b75c3d);
    --map-limestone: var(--color-limestone, #eee9df);
    --map-chalk: var(--color-chalk, #f7f3ea);
    --map-moss: var(--color-moss, #8d9588);
    --map-ui: var(--font-body, "Commissioner Variable", "Commissioner", sans-serif);
    --map-display: var(--font-display, "Prata", serif);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(5.5rem, 9vw, 10rem) clamp(1.25rem, 4.45vw, 4rem);
    color: var(--map-limestone);
    background:
      radial-gradient(circle at 79% 13%, rgba(91, 37, 52, 0.2), transparent 28rem),
      linear-gradient(132deg, var(--map-vineyard), var(--map-ink) 58%);
    font-family: var(--map-ui);
  }

  .map::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image: repeating-linear-gradient(
      103deg,
      transparent 0,
      transparent 49px,
      rgba(238, 233, 223, 0.025) 50px,
      transparent 51px
    );
    content: "";
    pointer-events: none;
  }

  .map__heading {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.58fr);
    gap: clamp(2rem, 6vw, 8rem);
    align-items: end;
    margin: 0 auto clamp(3rem, 6vw, 6rem);
    max-width: 112rem;
  }

  .map__eyebrow,
  .map__field > span:first-child,
  .map__canvas-meta,
  .map__results-head,
  .map__card-state {
    font-size: 0.68rem;
    font-weight: 540;
    line-height: 1.2;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .map__eyebrow {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin: 0 0 1.4rem;
    color: rgba(238, 233, 223, 0.62);
  }

  .map__eyebrow::before {
    width: 2.75rem;
    height: 1px;
    background: var(--map-clay);
    content: "";
  }

  .map h2 {
    max-width: 13ch;
    margin: 0;
    font-family: var(--map-display);
    font-size: clamp(3.25rem, 7vw, 8.25rem);
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: -0.045em;
  }

  .map__introduction {
    max-width: 33rem;
    margin: 0;
    color: rgba(238, 233, 223, 0.7);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    font-weight: 320;
    line-height: 1.72;
  }

  .map__filters {
    display: grid;
    grid-template-columns: minmax(15rem, 1.6fr) repeat(2, minmax(11rem, 0.85fr)) auto;
    gap: 1px;
    max-width: 112rem;
    margin: 0 auto;
    border: 1px solid rgba(238, 233, 223, 0.2);
    background: rgba(238, 233, 223, 0.2);
  }

  .map__field {
    display: grid;
    gap: 0.6rem;
    min-width: 0;
    padding: 0.9rem 1.1rem 0.75rem;
    background: rgba(16, 21, 16, 0.93);
  }

  .map__field > span:first-child {
    color: rgba(238, 233, 223, 0.48);
  }

  .map__input-wrap,
  .map__select-wrap {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .map__input-wrap > svg {
    flex: 0 0 auto;
    margin-right: 0.75rem;
    fill: none;
    stroke: var(--map-clay);
    stroke-linecap: round;
    stroke-width: 1.45;
  }

  .map__field input,
  .map__field select {
    width: 100%;
    min-width: 0;
    height: 1.75rem;
    padding: 0;
    border: 0;
    outline: 0;
    color: var(--map-limestone);
    background: transparent;
    font: 400 0.94rem/1.2 var(--map-ui);
  }

  .map__field input::placeholder {
    color: rgba(238, 233, 223, 0.43);
    opacity: 1;
  }

  .map__field input::-webkit-search-cancel-button {
    filter: invert(1);
    opacity: 0.58;
  }

  .map__field select {
    appearance: none;
    cursor: pointer;
  }

  .map__field select option {
    color: var(--map-ink);
    background: var(--map-limestone);
  }

  .map__select-wrap {
    position: relative;
