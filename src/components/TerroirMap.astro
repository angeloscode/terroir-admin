  .map__select-wrap svg {
    position: absolute;
    right: 0;
    fill: none;
    stroke: rgba(238, 233, 223, 0.65);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.4;
    pointer-events: none;
  }

  .map__reset {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    justify-content: center;
    min-width: 10rem;
    min-height: 4.9rem;
    padding: 1rem 1.4rem;
    border: 0;
    color: var(--map-limestone);
    background: var(--map-grape);
    font: 520 0.7rem/1 var(--map-ui);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 180ms ease, opacity 180ms ease;
  }

  .map__reset svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.3;
  }

  .map__reset:hover:not(:disabled) {
    background: var(--map-clay);
  }

  .map__reset:disabled {
    opacity: 0.38;
    cursor: default;
  }

  .map__body {
    display: grid;
    grid-template-columns: minmax(0, 1.72fr) minmax(20rem, 0.72fr);
    min-height: clamp(39rem, 61vw, 53rem);
    max-width: 112rem;
    margin: -1px auto 0;
    border: 1px solid rgba(238, 233, 223, 0.2);
  }

  .map__canvas {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background:
      linear-gradient(rgba(238, 233, 223, 0.018), rgba(238, 233, 223, 0)),
      #121812;
  }

  .map__canvas-meta {
    position: absolute;
    z-index: 2;
    top: 1.3rem;
    right: 1.4rem;
    left: 1.4rem;
    display: flex;
    justify-content: space-between;
