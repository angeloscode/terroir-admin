# Скопируйте в .env рядом с compose.yml

# Локально: ":80" (HTTP). В проде: "example.com" -> Caddy сам выпустит HTTPS
SITE_ADDRESS=:80
PUBLIC_SITE_URL=http://localhost
ACME_EMAIL=you@example.com

# Порты на хосте
HTTP_PORT=80
HTTPS_PORT=443

# openssl rand -base64 32
AUTH_SECRET=

POSTGRES_USER=terroir
POSTGRES_PASSWORD=
POSTGRES_DB=terroir_admin
